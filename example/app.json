{
  "expo": {
    "name": "Switchboard Voice Example",
    "slug": "switchboard-voice-expo-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://s3.amazonaws.com/synervoz-android-maven-repository"],
            "useLegacyPackaging": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a", "x86_64"]
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.switchboard.voiceexample",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs microphone access for voice recognition"
      },
      "appleTeamId": "NQ2VLM7NM7"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.switchboard.voiceexample"
    }
  }
}
